# Local Flask API (Vite proxies /api to this address during development).
# Leave VITE_API_URL unset for a production build served by Flask at /dashboard.
VITE_API_URL=http://127.0.0.1:5001

# Must match API_SECRET_KEY in the repository-root .env used by Flask.
VITE_API_KEY=replace-with-your-local-api-secret
VITE_DEMO_USER_ID=demo@gmail.com
