+
+function displayReportLink(data) {
+    const link = document.getElementById("reportLink");
+
+    // report_url is only present when /analyze recognized this as an
+    // add-in call (API key + user_id) -- it's a one-click,
+    // short-lived (10 min) link that logs the browser into this same
+    // mailbox's website session and opens this investigation, with
+    // that account's history available right after. Office.js can't
+    // read cross-origin cookies, so this has to be a real link the
+    // user clicks, not an automatic redirect.
+    if (data.report_url) {
+        link.href = data.report_url;
+        link.classList.remove("hidden");
+    } else {
+        link.classList.add("hidden");
